# Website. Copy to .env.local (never commit .env.local)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
STORE_TIMEZONE=America/Chicago
# Set both to enable real Supabase catalog/admin. Use the Publishable Key (or legacy anon key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. Supabase secret/service_role key — NEVER NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# SERVER ONLY. Test key for development; live key only after launch approval.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: use after verifying real business details.
NEXT_PUBLIC_SHOP_NAME=Brew & Bean Coffee
